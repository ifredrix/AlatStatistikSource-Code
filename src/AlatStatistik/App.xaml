<Application x:Class="AlatStatistik.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- Palet retro (gaya Windows 9x): muka 3D perak, tepi timbul,
             aksen navy, teks hitam di atas perak. -->
        <SolidColorBrush x:Key="Latar" Color="#D4D0C8"/>
        <SolidColorBrush x:Key="Panel" Color="#D4D0C8"/>
        <SolidColorBrush x:Key="Panel2" Color="#D4D0C8"/>
        <SolidColorBrush x:Key="Panel3" Color="#BFBFBF"/>
        <SolidColorBrush x:Key="PanelCerah" Color="#ECE9E3"/>
        <SolidColorBrush x:Key="Putih" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Garis" Color="#808080"/>
        <SolidColorBrush x:Key="Teks" Color="#000000"/>
        <SolidColorBrush x:Key="TeksRedup" Color="#808080"/>
        <SolidColorBrush x:Key="Aksen" Color="#000080"/>
        <SolidColorBrush x:Key="AksenTua" Color="#00005A"/>
        <SolidColorBrush x:Key="AksenMuda" Color="#1084D0"/>
        <SolidColorBrush x:Key="GarisKontrol" Color="#808080"/>
        <SolidColorBrush x:Key="Fokus" Color="#000000"/>
        <SolidColorBrush x:Key="Sukses" Color="#006100"/>
        <SolidColorBrush x:Key="SuksesMuda" Color="#00A000"/>
        <SolidColorBrush x:Key="Peringatan" Color="#9C6500"/>
        <SolidColorBrush x:Key="Bahaya" Color="#C00000"/>

        <!-- Tepi bevel: terang di luar + gelap di dalam = timbul (tombol/tab);
             gelap di luar + terang di dalam = cekung (kolom isian). -->
        <SolidColorBrush x:Key="TepiTerang" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TepiGelap" Color="#808080"/>
        <SolidColorBrush x:Key="TepiSangatGelap" Color="#404040"/>

        <!-- Cincin fokus klasik: persegi panjang putus-putus hitam. -->
        <Style x:Key="CincinFokus" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-1"
                                   StrokeThickness="1"
                                   Stroke="{StaticResource Teks}"
                                   StrokeDashArray="1 1"
                                   SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Window">
            <Setter Property="Background" Value="{StaticResource Latar}"/>
            <Setter Property="Foreground" Value="{StaticResource Teks}"/>
            <Setter Property="FontFamily" Value="Tahoma, Microsoft Sans Serif"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Teks}"/>
            <Setter Property="FontFamily" Value="Tahoma, Microsoft Sans Serif"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        </Style>

        <Style TargetType="Menu">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="FontFamily" Value="Tahoma, Microsoft Sans Serif"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Teks}"/>
            <Setter Property="FontFamily" Value="Tahoma, Microsoft Sans Serif"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <Border x:Name="Bingkai"
                                    Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                                  VerticalAlignment="Center" HorizontalAlignment="Left"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                            <Popup x:Name="Popup"
                                   IsOpen="{TemplateBinding IsSubmenuOpen}"
                                   Placement="Bottom"
                                   HorizontalOffset="-2" VerticalOffset="0"
                                   Focusable="False" PopupAnimation="None">
                                <Border Background="{StaticResource Panel}"
                                        BorderBrush="{StaticResource TepiGelap}" BorderThickness="1" Padding="2">
                                    <StackPanel IsItemsHost="True"
                                                KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Role" Value="SubmenuHeader">
                                <Setter TargetName="Popup" Property="Placement" Value="Right"/>
                                <Setter TargetName="Popup" Property="HorizontalOffset" Value="0"/>
                                <Setter TargetName="Popup" Property="VerticalOffset" Value="-1"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bingkai" Property="Background" Value="{StaticResource Aksen}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Separator">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="4,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Grid>
                            <Rectangle Height="1" VerticalAlignment="Top" Fill="{StaticResource TepiGelap}"/>
                            <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{StaticResource TepiTerang}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="Foreground" Value="{StaticResource Teks}"/>
            <Setter Property="FontFamily" Value="Tahoma, Microsoft Sans Serif"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource CincinFokus}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Luar" BorderThickness="1" BorderBrush="{StaticResource TepiTerang}"
                                    Background="{TemplateBinding Background}">
                                <Border x:Name="Dalam" BorderThickness="1" BorderBrush="{StaticResource TepiGelap}" Margin="1">
                                    <ContentPresenter x:Name="Isi" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
                                </Border>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Luar" Property="Background" Value="{StaticResource PanelCerah}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Luar" Property="BorderBrush" Value="{StaticResource TepiSangatGelap}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Luar" Property="BorderBrush" Value="{StaticResource TepiGelap}"/>
                                <Setter TargetName="Dalam" Property="BorderBrush" Value="{StaticResource TepiTerang}"/>
                                <Setter TargetName="Isi" Property="Margin" Value="13,6,11,4"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Luar" Property="Background" Value="{StaticResource Panel}"/>
                                <Setter TargetName="Luar" Property="BorderBrush" Value="{StaticResource TepiTerang}"/>
                                <Setter TargetName="Dalam" Property="BorderBrush" Value="{StaticResource TepiGelap}"/>
                                <Setter Property="Foreground" Value="{StaticResource TeksRedup}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TombolUtama" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Aksen}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AksenTua}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Luar" BorderThickness="1" BorderBrush="{StaticResource TepiTerang}"
                                    Background="{TemplateBinding Background}">
                                <Border x:Name="Dalam" BorderThickness="1" BorderBrush="{StaticResource TepiSangatGelap}" Margin="1">
                                    <ContentPresenter x:Name="Isi" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
                                </Border>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Luar" Property="Background" Value="{StaticResource AksenMuda}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Luar" Property="BorderBrush" Value="{StaticResource TepiTerang}"/>
                                <Setter TargetName="Dalam" Property="BorderBrush" Value="{StaticResource TepiTerang}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Luar" Property="BorderBrush" Value="{StaticResource TepiSangatGelap}"/>
                                <Setter TargetName="Dalam" Property="BorderBrush" Value="{StaticResource TepiTerang}"/>
                                <Setter TargetName="Isi" Property="Margin" Value="13,6,11,4"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Luar" Property="Background" Value="{StaticResource AksenTua}"/>
                                <Setter Property="Foreground" Value="#C0C0C0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Putih}"/>
            <Setter Property="Foreground" Value="{StaticResource Teks}"/>
            <Setter Property="FontFamily" Value="Tahoma, Microsoft Sans Serif"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="CaretBrush" Value="{StaticResource Teks}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource CincinFokus}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Luar" BorderThickness="1" BorderBrush="{StaticResource TepiGelap}"
                                Background="{TemplateBinding Background}">
                            <Border x:Name="Dalam" BorderThickness="1" BorderBrush="{StaticResource TepiTerang}" Margin="1">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="1" Background="{TemplateBinding Background}"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Luar" Property="Background" Value="{StaticResource Panel}"/>
                                <Setter Property="Foreground" Value="{StaticResource TeksRedup}"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="Luar" Property="Background" Value="{StaticResource Panel}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource Putih}"/>
            <Setter Property="Foreground" Value="{StaticResource Teks}"/>
            <Setter Property="FontFamily" Value="Tahoma, Microsoft Sans Serif"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource CincinFokus}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Luar" Grid.Column="0" BorderThickness="1" BorderBrush="{StaticResource TepiGelap}"
                                    Background="{TemplateBinding Background}">
                                <Border x:Name="Dalam" BorderThickness="1" BorderBrush="{StaticResource TepiTerang}" Margin="1">
                                    <ContentPresenter x:Name="ContentSite" Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center" HorizontalAlignment="Left"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      IsHitTestVisible="False"/>
                                </Border>
                            </Border>
                            <ToggleButton x:Name="ToggleButton" Grid.Column="1" Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="B" BorderThickness="1" BorderBrush="{StaticResource TepiTerang}"
                                                Background="{StaticResource Panel}" Margin="0">
                                            <Border x:Name="Bd" BorderThickness="1" BorderBrush="{StaticResource TepiGelap}" Margin="1">
                                                <Path Data="M 0 0 L 7 0 L 3.5 4 Z" Fill="{StaticResource Teks}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource TepiGelap}"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource TepiTerang}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="False" Focusable="False" PopupAnimation="None"
                                   Grid.ColumnSpan="2">
                                <Border Background="{StaticResource Putih}"
                                        BorderBrush="{StaticResource TepiGelap}" BorderThickness="1" Margin="1">
                                    <ScrollViewer>
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Teks}"/>
            <Setter Property="FontFamily" Value="Tahoma, Microsoft Sans Serif"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource CincinFokus}"/>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{StaticResource Latar}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid SnapsToDevicePixels="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel x:Name="HeaderPanel" Grid.Row="0" Panel.ZIndex="1"
                                      Margin="2,2,2,0" IsItemsHost="True"
                                      KeyboardNavigation.TabIndex="1"/>
                            <Border Grid.Row="1" BorderThickness="1" BorderBrush="{StaticResource TepiGelap}"
                                    Background="{TemplateBinding Background}">
                                <Border BorderThickness="1" BorderBrush="{StaticResource TepiTerang}" Margin="1">
                                    <ContentPresenter x:Name="PART_SelectedContentHost"
                                                      ContentSource="SelectedContent"
                                                      Margin="2" SnapsToDevicePixels="True"/>
                                </Border>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="Foreground" Value="{StaticResource Teks}"/>
            <Setter Property="FontFamily" Value="Tahoma, Microsoft Sans Serif"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid>
                            <Border x:Name="Bingkai" BorderThickness="1" BorderBrush="{StaticResource TepiTerang}"
                                    Background="{TemplateBinding Background}" Margin="0,0,2,0">
                                <Border BorderThickness="1" BorderBrush="{StaticResource TepiGelap}" Margin="1">
                                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Margin="{TemplateBinding Padding}"/>
                                </Border>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bingkai" Property="Background" Value="{StaticResource Latar}"/>
                                <Setter TargetName="Bingkai" Property="Margin" Value="0,0,2,-1"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bingkai" Property="Background" Value="{StaticResource PanelCerah}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- GroupBox klasik: bingkai cekung (etched) dengan judul di garis atas. -->
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{StaticResource Teks}"/>
            <Setter Property="FontFamily" Value="Tahoma, Microsoft Sans Serif"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid SnapsToDevicePixels="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Grid.RowSpan="2" BorderThickness="1" BorderBrush="{StaticResource TepiGelap}">
                                <Border BorderThickness="1" BorderBrush="{StaticResource TepiTerang}" Margin="1"/>
                            </Border>
                            <DockPanel Grid.Row="0" Margin="8,0,0,0" VerticalAlignment="Top">
                                <Border Background="{StaticResource Latar}" Padding="4,0,2,0">
                                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                                      TextElement.Foreground="{StaticResource Teks}"
                                                      TextElement.FontWeight="Bold"/>
                                </Border>
                            </DockPanel>
                            <ContentPresenter Grid.Row="1" Margin="{TemplateBinding Padding}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource Putih}"/>
            <Setter Property="Foreground" Value="{StaticResource Teks}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="1"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource CincinFokus}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border x:Name="Luar" BorderThickness="1" BorderBrush="{StaticResource TepiGelap}"
                                Background="{TemplateBinding Background}">
                            <Border x:Name="Dalam" BorderThickness="1" BorderBrush="{StaticResource TepiTerang}" Margin="1">
                                <ScrollViewer Margin="1" Focusable="False">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Teks}"/>
            <Setter Property="FontFamily" Value="Tahoma, Microsoft Sans Serif"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource CincinFokus}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bingkai" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bingkai" Property="Background" Value="{StaticResource Panel3}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bingkai" Property="Background" Value="{StaticResource Aksen}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Kartu" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource TepiGelap}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource Putih}"/>
            <Setter Property="Foreground" Value="{StaticResource Teks}"/>
            <Setter Property="BorderBrush" Value="{StaticResource TepiGelap}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="{StaticResource Putih}"/>
            <Setter Property="AlternatingRowBackground" Value="#F0EDE6"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#C0C0C0"/>
            <Setter Property="VerticalGridLinesBrush" Value="#C0C0C0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
            <Setter Property="MinRowHeight" Value="26"/>
            <Setter Property="RowHeight" Value="26"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="Foreground" Value="{StaticResource Teks}"/>
            <Setter Property="FontFamily" Value="Tahoma, Microsoft Sans Serif"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border BorderThickness="1" BorderBrush="{StaticResource TepiTerang}"
                                Background="{TemplateBinding Background}">
                            <Border BorderThickness="1" BorderBrush="{StaticResource TepiGelap}" Margin="1">
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Teks}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource Aksen}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource Teks}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource Aksen}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="StatusBar">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="Foreground" Value="{StaticResource Teks}"/>
            <Setter Property="FontFamily" Value="Tahoma, Microsoft Sans Serif"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="BorderThickness" Value="1,1,1,0"/>
            <Setter Property="BorderBrush" Value="{StaticResource TepiGelap}"/>
            <Setter Property="Padding" Value="2"/>
        </Style>
    </Application.Resources>
</Application>

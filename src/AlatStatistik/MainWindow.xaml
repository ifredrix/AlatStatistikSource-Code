<Window x:Class="AlatStatistik.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AlatStatistik"
        Title="AlatStatistik — analisis statistik" Height="820" Width="1280"
        MinHeight="520" MinWidth="860"
        SizeChanged="Jendela_UkuranBerubah">

    
    
    
    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="Undo"/>
        <KeyBinding Key="S" Modifiers="Control" Command="Save"/>
        <KeyBinding Command="{x:Static local:MainWindow.CariAlat}" Gesture="Ctrl+K"/>
        <KeyBinding Command="{x:Static local:MainWindow.UlangiAnalisis}" Gesture="Ctrl+Enter"/>
        <KeyBinding Command="{x:Static local:MainWindow.EksporWord}" Gesture="Ctrl+E"/>
        <KeyBinding Command="{x:Static local:MainWindow.EksporHasil}" Gesture="Ctrl+Shift+E"/>
        <KeyBinding Command="{x:Static local:MainWindow.SalinHasil}" Gesture="Ctrl+Shift+C"/>
        <KeyBinding Command="{x:Static local:MainWindow.PergiTab}" CommandParameter="0" Gesture="Ctrl+1"/>
        <KeyBinding Command="{x:Static local:MainWindow.PergiTab}" CommandParameter="1" Gesture="Ctrl+2"/>
        <KeyBinding Command="{x:Static local:MainWindow.PergiTab}" CommandParameter="2" Gesture="Ctrl+3"/>
        <KeyBinding Command="{x:Static local:MainWindow.PergiTab}" CommandParameter="3" Gesture="Ctrl+4"/>
    </Window.InputBindings>

    <DockPanel>

        
        
        <Menu x:Name="MenuUtama" DockPanel.Dock="Top">
            <MenuItem Header="_Berkas">
                <MenuItem Header="Data baru (kosong)..." Click="DataBaru_Click"/>
                <Separator/>
                <MenuItem Header="_Buka data (CSV, TSV, atau .sav)..." InputGestureText="Ctrl+O" Click="BukaData_Click"/>
                <MenuItem Header="Muat contoh data" Click="MuatContoh_Click"/>
                <Separator/>
                <MenuItem Header="_Simpan" InputGestureText="Ctrl+S" Click="Simpan_Click"/>
                <MenuItem Header="Simpan sebagai..." InputGestureText="Ctrl+Shift+S" Click="SimpanData_Click"/>
                <MenuItem Header="Konversi berkas data ke format lain..." Click="KonversiBerkas_Click"/>
                <Separator/>
                <MenuItem Header="Ekspor keluaran ke Word (tabel asli)…" InputGestureText="Ctrl+E" Click="EksporDocx_Click"/>
                <MenuItem Header="Ekspor keluaran ke HTML…" InputGestureText="Ctrl+Shift+E" Click="EksporHtml_Click"/>
                <MenuItem Header="Salin keluaran ke clipboard" InputGestureText="Ctrl+Shift+C" Click="SalinHasil_Click"/>
                <Separator/>
                <MenuItem Header="Keluar" Click="Keluar_Click"/>
            </MenuItem>

            <MenuItem Header="_Data">
                <MenuItem Header="Sisipkan baris baru..." Click="SisipBaris_Click"/>
                <MenuItem Header="Sisipkan variabel (kolom) baru..." Click="SisipKolom_Click"/>
                <MenuItem Header="Ganti nama variabel..." Click="GantiNamaKolom_Click"/>
                <MenuItem Header="Hapus variabel (kolom)..." Click="HapusKolom_Click"/>

                <MenuItem Header="Urutkan baris..." Click="UrutkanBaris_Click"/>
                <MenuItem Header="Urutkan variabel (kolom)..." Click="UrutkanVariabel_Click"/>
                <MenuItem Header="Pilih kasus (saring baris)..." Click="PilihKasus_Click"/>
                <Separator/>
                <MenuItem Header="Laporan kualitas data..." Click="LaporanKualitas_Click"/>
                <MenuItem Header="Tangani nilai kosong..." Click="TanganiKosong_Click"/>
                <MenuItem Header="Buang baris duplikat" Click="BuangDuplikat_Click"/>
                <MenuItem Header="Tangani pencilan..." Click="TanganiPencilan_Click"/>
                <Separator/>
                <MenuItem Header="Normalisasi..." Click="Normalisasi_Click"/>
                <MenuItem Header="Ubah kategori jadi angka..." Click="Pengkodean_Click"/>
                <MenuItem Header="Bagi data latih &amp; uji..." Click="BagiData_Click"/>
                <Separator/>
                <MenuItem Header="Urungkan perubahan terakhir" InputGestureText="Ctrl+Z" Click="UrungkanPerubahan_Click"/>
            </MenuItem>

            <MenuItem Header="_Ubah">
                <MenuItem Header="Hitung variabel..." Click="HitungVariabel_Click"/>
                <MenuItem Header="Beri peringkat (Rank Cases)..." Click="BeriPeringkat_Click"/>
                <MenuItem Header="Ubah nilai (Recode)..." Click="UbahNilai_Click"/>
                <MenuItem Header="Isi nilai hilang..." Click="IsiNilaiHilang_Click"/>
            </MenuItem>

            
            
            
            <MenuItem x:Name="MenuAnalisis" Header="_Analisis">
                <MenuItem Header="Cari alat..." InputGestureText="Ctrl+K" Click="CariAlat_Click"/>
                <MenuItem Header="Ulangi analisis terakhir" InputGestureText="Ctrl+Enter" Click="Ulangi_Click"/>
                <Separator/>
            </MenuItem>

            <MenuItem Header="_Grafik">
                <MenuItem Header="Histogram..." Click="GrafikHistogram_Click"/>
                <MenuItem Header="Box plot..." Click="GrafikBox_Click"/>
                <MenuItem Header="Diagram pencar..." Click="GrafikPencar_Click"/>
                <MenuItem Header="Diagram batang (frekuensi)..." Click="GrafikBatang_Click"/>
                <MenuItem Header="Diagram garis..." Click="GrafikGaris_Click"/>
                <MenuItem Header="Diagram lingkaran..." Click="GrafikLingkaran_Click"/>
                <MenuItem Header="Peta panas (korelasi)..." Click="GrafikPetaPanas_Click"/>
            </MenuItem>

            <MenuItem Header="_Bantuan">
                <MenuItem x:Name="ItemLabelNilai" Header="Tampilkan _label nilai" IsCheckable="True"
                          ToolTip="Tampilkan label nilai alih-alih kodenya di tab Data"
                          Click="LabelNilai_Click"/>
                <Separator/>
                <MenuItem Header="Uji validasi (bandingkan dengan SciPy)" Click="UjiValidasi_Click"/>
                <Separator/>
                <MenuItem Header="Tentang AlatStatistik" Click="Tentang_Click"/>
            </MenuItem>
        </Menu>

        
        <Border DockPanel.Dock="Top" Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Garis}" BorderThickness="0,0,0,1" Padding="10,6">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Buka data" Padding="14,6" Margin="0,0,8,0" Click="BukaData_Click"
                            ToolTip="Buka berkas data (Ctrl+O)"/>
                    <Button Content="Simpan" Padding="14,6" Margin="0,0,8,0" Click="Simpan_Click"
                            ToolTip="Simpan data (Ctrl+S)"/>
                    <Button Content="Urungkan" Padding="14,6" Click="Urubahan_Click"
                            ToolTip="Urungkan perubahan terakhir (Ctrl+Z)"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Ekspor ke Word…" Padding="14,6" Margin="0,0,8,0"
                            Click="EksporDocx_Click"
                            ToolTip="Simpan seluruh keluaran menjadi Word — tabel asli bisa diedit (Ctrl+E)"/>
                    <Button Content="Ekspor ke HTML…" Padding="14,6" Margin="0,0,8,0"
                            Click="EksporHtml_Click"
                            ToolTip="Simpan seluruh keluaran menjadi laporan HTML (Ctrl+Shift+E)"/>
                    <Button Content="Salin keluaran" Padding="14,6" Click="SalinHasil_Click"
                            ToolTip="Salin seluruh keluaran ke clipboard (Ctrl+Shift+C)"/>
                </StackPanel>
            </DockPanel>
        </Border>

        
        <StatusBar DockPanel.Dock="Bottom" Background="{StaticResource Panel}">
            <StatusBarItem>
                <TextBlock x:Name="InfoData" Text="Belum ada data"
                           Foreground="{StaticResource TeksRedup}"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="·" Foreground="{StaticResource TeksRedup}" Margin="0,0,6,0"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock x:Name="InfoAnalisis" Text="Belum ada analisis dijalankan"
                           Foreground="{StaticResource TeksRedup}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="Ctrl+K cari alat · Ctrl+Enter ulangi · Ctrl+E ekspor · Ctrl+Z urungkan"
                           FontSize="11" Foreground="{StaticResource TeksRedup}"/>
            </StatusBarItem>
        </StatusBar>

        <TabControl x:Name="TabUtama" Margin="0" Padding="0"
                    SelectionChanged="TabUtama_SelectionChanged">

            <TabItem Header="_Data">
                <DataGrid x:Name="GridData" Margin="0"
                          AutoGenerateColumns="True"
                          CanUserSortColumns="False"
                          MinColumnWidth="88"
                          ColumnWidth="SizeToCells"
                          HorizontalScrollBarVisibility="Auto"
                          BeginningEdit="GridData_BeginningEdit"
                          CellEditEnding="GridData_CellEditEnding"/>
            </TabItem>

            <TabItem Header="_Variabel">
                <DockPanel Margin="14">
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8"
                               Foreground="{StaticResource TeksRedup}" TextWrapping="Wrap"
                               Text="Tingkat ukur menentukan variabel mana yang bisa dipakai di analisis mana. Ketiga kolom selain Nama (Label, Tingkat ukur, Desimal) bisa disunting langsung — keterangan kolom yang sedang dipilih ada di bawah tabel."/>
                    <Border DockPanel.Dock="Bottom" Margin="0,10,0,0" Padding="12,8"
                            Background="{StaticResource Panel2}"
                            BorderBrush="{StaticResource Garis}" BorderThickness="1"
                            CornerRadius="4">
                        <StackPanel>
                            <TextBlock Text="Keterangan kolom" FontWeight="SemiBold"
                                       Foreground="{StaticResource TeksRedup}"/>
                            <TextBlock x:Name="InfoKolomVariabel" Margin="0,2,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource Teks}"/>
                        </StackPanel>
                    </Border>
                    <DataGrid x:Name="GridVariabel" AutoGenerateColumns="False"
                              AddingNewItem="GridVariabel_AddingNewItem"
                              BeginningEdit="GridVariabel_BeginningEdit"
                              CellEditEnding="GridVariabel_CellEditEnding"
                              CurrentCellChanged="GridVariabel_CurrentCellChanged"
                              SelectionChanged="GridVariabel_SelectionChanged"/>
                </DockPanel>
            </TabItem>

            
            
            
            
            <TabItem x:Name="TabKeluaran" Header="_Keluaran">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="KolomKerangka" Width="230"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    
                    <Border Grid.Column="0" Background="{StaticResource Panel2}"
                            BorderBrush="{StaticResource Garis}" BorderThickness="0,0,1,0">
                        <DockPanel Margin="12">
                            <TextBlock DockPanel.Dock="Top" Text="Kerangka keluaran"
                                       FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock x:Name="InfoKeluaran" DockPanel.Dock="Top" FontSize="11"
                                       Foreground="{StaticResource TeksRedup}" Margin="0,0,0,10"
                                       TextWrapping="Wrap" Text="Belum ada keluaran."/>
                            <ListBox x:Name="DaftarKeluaran"
                                     AutomationProperties.Name="Kerangka keluaran"
                                     SelectionChanged="DaftarKeluaran_SelectionChanged">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Judul}"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,2">
                                            <TextBlock Text="{Binding Judul}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Waktu}" FontSize="11"
                                                       Foreground="{StaticResource TeksRedup}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    
                    <DockPanel Grid.Column="1" Margin="14" LastChildFill="True">

                        <Border DockPanel.Dock="Top" Padding="0,0,0,10"
                                BorderBrush="{StaticResource Garis}" BorderThickness="0,0,0,1"
                                Margin="0,0,0,10">
                            <DockPanel LastChildFill="False">
                                <Button DockPanel.Dock="Right" x:Name="TombolBersihkanKeluaran"
                                        Content="Bersihkan" Padding="14,6" IsEnabled="False"
                                        Click="BersihkanKeluaran_Click"
                                        ToolTip="Buang semua keluaran dari jendela ini"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="TombolEksporKeluaran" Content="Ekspor ke Word…"
                                            Style="{StaticResource TombolUtama}"
                                            Padding="16,6" IsEnabled="False"
                                            Click="EksporDocx_Click"
                                            ToolTip="Simpan seluruh keluaran menjadi Word — tabel asli bisa diedit dan diformat (Ctrl+E)"/>
                                    <Button x:Name="TombolEksporHtmlKeluaran" Content="Ekspor ke HTML…"
                                            Padding="14,6" Margin="10,0,0,0" IsEnabled="False"
                                            Click="EksporHtml_Click"
                                            ToolTip="Simpan seluruh keluaran menjadi laporan HTML (Ctrl+Shift+E)"/>
                                    <Button x:Name="TombolSalinKeluaran" Content="Salin semua"
                                            Padding="14,6" Margin="10,0,0,0" IsEnabled="False"
                                            Click="SalinHasil_Click"
                                            ToolTip="Salin seluruh keluaran ke clipboard (Ctrl+Shift+C)"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Grid>
                            
                            <Border x:Name="KeadaanKosong" Style="{StaticResource Kartu}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    MaxWidth="520" Padding="28,24">
                                <StackPanel>
                                    <TextBlock Text="Belum ada keluaran" FontSize="16"
                                               FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TeksRedup}"
                                               Margin="0,0,0,14"
                                               Text="Tab ini adalah penampung hasilnya — mirip Output Viewer di SPSS. Setiap analisis yang dijalankan ditambahkan di sini secara berurutan, jadi hasil yang lama tidak tertimpa. Kerangka di kiri memudahkan loncat ke hasil tertentu."/>
                                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TeksRedup}"
                                               Margin="0,0,0,16"
                                               Text="Mulai dari menu Analisis, atau cari nama alatnya langsung."/>
                                    <Button Content="Cari alat...  (Ctrl+K)" HorizontalAlignment="Left"
                                            Padding="16,7" Style="{StaticResource TombolUtama}"
                                            Click="CariAlat_Click"/>
                                </StackPanel>
                            </Border>

                            <ScrollViewer x:Name="GulirKeluaran" Visibility="Collapsed"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Auto">
                                <StackPanel x:Name="PanelHasil" AutomationProperties.LiveSetting="Polite"/>
                            </ScrollViewer>
                        </Grid>
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="_Riwayat">
                <DockPanel Margin="14">
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8"
                               Foreground="{StaticResource TeksRedup}" TextWrapping="Wrap"
                               Text="Setiap sunting sel pada tab Data tercatat di sini. 'Desimal' hanya memformat tampilan, bukan nilai yang disimpan: sel yang menampilkan 70,69 tetap bernilai penuh. Tekan Ctrl+Z dari mana saja untuk urungkan yang paling akhir."/>

                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="TombolUndo" Content="Urungkan perubahan terakhir"
                                Click="Urubahan_Click" Padding="12,5" Margin="0,0,10,0"/>
                        <Button x:Name="TombolBersihkanRiwayat" Content="Bersihkan riwayat"
                                Click="BersihkanRiwayat_Click" Padding="12,5"/>
                        <TextBlock x:Name="InfoRiwayat" Margin="14,7,0,0" Text="Tidak ada perubahan tercatat."
                                   Foreground="{StaticResource TeksRedup}"/>
                    </StackPanel>

                    <DataGrid x:Name="GridRiwayat" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False"
                              RowHeaderWidth="0" SelectionMode="Single"
                              Margin="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Waktu"
                                                Binding="{Binding Waktu, StringFormat=HH:mm:ss}"
                                                Width="100"/>
                            <DataGridTextColumn Header="Jenis"
                                                Binding="{Binding Jenis}" Width="80"/>
                            <DataGridTextColumn Header="Kolom"
                                                Binding="{Binding Kolom}" Width="120"/>
                            <DataGridTextColumn Header="Baris"
                                                Binding="{Binding BarisSatu}"
                                                Width="60"/>
                            <DataGridTextColumn Header="Nilai lama"
                                                Binding="{Binding NilaiLama, TargetNullValue=(kosong)}"
                                                Width="*"/>
                            <DataGridTextColumn Header="Nilai baru"
                                                Binding="{Binding NilaiBaru, TargetNullValue=(kosong)}"
                                                Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>

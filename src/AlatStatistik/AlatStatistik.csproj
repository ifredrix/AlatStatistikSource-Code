<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <AssemblyName>AlatStatistik</AssemblyName>
    <RootNamespace>AlatStatistik</RootNamespace>

    <!-- Manifest: deklarasi DPI per-monitor (PerMonitorV2) dan level eksekusi
         asInvoker. Tanpa ini, perilaku DPI mengikuti bawaan runtime dan jendela
         bisa buram/pecah di layar 125%/150% (lihat docs/SKENARIO-UJI-LINGKUNGAN.md). -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Versi rilis: self-contained (tidak butuh .NET terpasang di komputer
         pemakai). Dipasang lewat profil terbit di Properties/PublishProfiles,
         bukan di sini, supaya 'dotnet build' biasa tetap ringan dan tidak
         perlu mengunduh runtime pack. -->
    <!-- Versi rilis ditahan di 0.1.0.0 sampai pemilik produk memintanya
         dinaikkan. Jangan diubah tanpa persetujuan eksplisit. -->
    <Version>0.1.0.0</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  </Project>

<Window x:Class="AlatStatistik.DataPrep.JendelaCustomTables"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Custom Tables" Height="600" Width="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Table Info -->
        <GroupBox Grid.Row="0" Header="Informasi Tabel" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Column="0" Grid.Row="0" Text="Nomor Tabel:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox Grid.Column="1" Grid.Row="0" x:Name="textTableNumber" Text="1" Margin="0,0,10,5"/>
                
                <TextBlock Grid.Column="2" Grid.Row="0" Text="Judul Tabel:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox Grid.Column="3" Grid.Row="0" x:Name="textTableTitle" Text="Tabel Kustom" Margin="0,0,0,5"/>
            </Grid>
        </GroupBox>
        
        <!-- Main Content -->
        <TabControl Grid.Row="1">
            <!-- Dimensions Tab -->
            <TabItem Header="Dimensi">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Row Dimensions -->
                    <GroupBox Grid.Column="0" Header="Dimensi Baris">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <ComboBox Grid.Row="0" x:Name="comboRowVariable" Margin="0,0,0,5"/>
                            
                            <ListBox Grid.Row="1" x:Name="listRowDimensions" 
                                     DisplayMemberPath="Label" 
                                     SelectionMode="Single"
                                     Margin="0,0,0,5"/>
                            
                            <StackPanel Grid.Row="2" Orientation="Horizontal">
                                <CheckBox x:Name="checkRowTotal" Content="Total" Margin="0,0,10,0" IsChecked="True"/>
                                <CheckBox x:Name="checkRowSubtotal" Content="Subtotal" Margin="0,0,10,0"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                <Button Content="↑" Width="30" Margin="5,0" Click="MoveUpRow_Click"/>
                                <Button Content="↓" Width="30" Margin="5,0" Click="MoveDownRow_Click"/>
                                <Button Content="Tambah" Width="70" Margin="5,0" Click="AddRowDimension_Click"/>
                                <Button Content="Hapus" Width="70" Margin="5,0" Click="RemoveRowDimension_Click"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>
                    
                    <!-- Column Dimensions -->
                    <GroupBox Grid.Column="2" Header="Dimensi Kolom">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <ComboBox Grid.Row="0" x:Name="comboColumnVariable" Margin="0,0,0,5"/>
                            
                            <ListBox Grid.Row="1" x:Name="listColumnDimensions" 
                                     DisplayMemberPath="Label" 
                                     SelectionMode="Single"
                                     Margin="0,0,0,5"/>
                            
                            <StackPanel Grid.Row="2" Orientation="Horizontal">
                                <CheckBox x:Name="checkColumnTotal" Content="Total" Margin="0,0,10,0" IsChecked="True"/>
                                <CheckBox x:Name="checkColumnSubtotal" Content="Subtotal" Margin="0,0,10,0"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                <Button Content="↑" Width="30" Margin="5,0" Click="MoveUpColumn_Click"/>
                                <Button Content="↓" Width="30" Margin="5,0" Click="MoveDownColumn_Click"/>
                                <Button Content="Tambah" Width="70" Margin="5,0" Click="AddColumnDimension_Click"/>
                                <Button Content="Hapus" Width="70" Margin="5,0" Click="RemoveColumnDimension_Click"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>
            
            <!-- Statistics Tab -->
            <TabItem Header="Statistik">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Available Statistics -->
                    <GroupBox Grid.Column="0" Header="Statistik Tersedia">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <ListBox Grid.Row="0" x:Name="listStatistics" 
                                     SelectionMode="Single"
                                     Margin="0,0,0,5"/>
                            
                            <Button Grid.Row="1" Content="Tambah →" Width="100" 
                                    HorizontalAlignment="Right" Click="AddStatistic_Click"/>
                        </Grid>
                    </GroupBox>
                    
                    <!-- Selected Statistics -->
                    <GroupBox Grid.Column="2" Header="Statistik Dipilih">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <ListBox Grid.Row="0" x:Name="listSelectedStatistics" 
                                     SelectionMode="Single"
                                     Margin="0,0,0,5"/>
                            
                            <Button Grid.Row="1" Content="← Hapus" Width="100" 
                                    HorizontalAlignment="Left" Click="RemoveStatistic_Click"/>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>
            
            <!-- Options Tab -->
            <TabItem Header="Opsi">
                <GroupBox Header="Persentase">
                    <StackPanel>
                        <ComboBox x:Name="comboPercentType" Margin="0,0,0,10" 
                                  DisplayMemberPath="ToString"/>
                        
                        <CheckBox x:Name="checkRowPercent" Content="Tampilkan persentase per baris" Margin="0,0,0,5"/>
                        <CheckBox x:Name="checkColumnPercent" Content="Tampilkan persentase per kolom" Margin="0,0,0,5"/>
                        <CheckBox x:Name="checkTotalPercent" Content="Tampilkan persentase per total" Margin="0,0,0,5"/>
                        
                        <TextBlock Text="Catatan: Persentase dihitung berdasarkan Count (jumlah kasus)" 
                                   FontStyle="Italic" Foreground="Gray" Margin="0,10,0,0"/>
                    </StackPanel>
                </GroupBox>
            </TabItem>
        </TabControl>
        
        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" Width="80" Margin="0,0,10,0" Click="OK_Click"/>
            <Button Content="Batal" Width="80" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
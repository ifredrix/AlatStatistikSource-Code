<Project>
  <!-- Rilis untuk pemakai: self-contained, .NET runtime ikut terbawa, jadi
       komputer tanpa .NET 10 pun bisa menjalankan.
       Cara pakai:
         dotnet publish src/AlatStatistik/AlatStatistik.csproj -p:PublishProfile=win-x64
       Hasil: src/AlatStatistik/bin/Release/net10.0-windows/win-x64/publish/
       (Docker/VM bersih tanpa .NET bisa dipakai untuk menguji skenario R-04.) -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <PublishProtocol>FileSystem</PublishProtocol>
    <PublishDir>bin\Release\net10.0-windows\win-x64\publish\</PublishDir>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
</Project>

<Project>
  <!-- Sama seperti win-x64, untuk perangkat Windows on ARM (Copilot+ PC, Surface
       ARM). Bangunan x64 masih berjalan lewat emulasi, tetapi lebih lambat.
       Cara pakai:
         dotnet publish src/AlatStatistik/AlatStatistik.csproj -p:PublishProfile=win-arm64 -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <PublishProtocol>FileSystem</PublishProtocol>
    <PublishDir>bin\Release\net10.0-windows\win-arm64\publish\</PublishDir>
    <RuntimeIdentifier>win-arm64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
</Project>
